{
    "manifest_version": 3,
    "name": "Image Replacer",
    "version": "1.2",
    "description": "Replaces images with a colour mosaic on sites you switch it on for. Right-click a replaced image to restore it.",
    "permissions": ["storage", "contextMenus"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "src/sw.js",
        "scripts": [
            "src/replacement.js",
            "src/sites.js",
            "src/indicator.js",
            "src/menus.js",
            "src/background.js"
        ]
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "image-replacer@memetb.github.io",
            "strict_min_version": "115.0"
        }
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Toggle Image Replacement",
        "default_icon": {
            "16": "icons/icon-16.png",
            "48": "icons/icon-48.png",
            "96": "icons/icon-96.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": [
                "src/content/blank.js",
                "src/content/adapters.js",
                "src/content/pipeline.js",
                "src/content/main.js"
            ],
            "run_at": "document_start",
            "all_frames": true
        }
    ]
}
